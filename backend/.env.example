[TEMPLATE]
# ============================================================================
# Oracle Sanity Engine — Backend Environment Configuration
#
# Copy this file to `.env` and fill in the values for your deployment.
# Never commit the `.env` file to version control.
# ============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
ENABLE_LISTENER=true

# ---------------------------------------------------------------------------
# Soroban RPC
#
# HTTP endpoint for the Stellar/Soroban network the contract is deployed to.
# ---------------------------------------------------------------------------
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org

# ---------------------------------------------------------------------------
# Contract
#
# The deployed OmniCheck contract ID to monitor.
# ---------------------------------------------------------------------------
CONTRACT_ID=CB5HM7AHEDTQIEG6CBBGQZHWS63REXOHCAONZEMHS65QQ2XU7OY2APS5

# Stellar network passphrase used for transaction simulation.
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Poll interval (milliseconds) for reading contract state.
POLL_INTERVAL_MS=30000

# ---------------------------------------------------------------------------
# Alert Channels (optional — leave blank to disable)
#
# Slack: Create an Incoming Webhook at https://api.slack.com/messaging/webhooks
# Telegram: Create a bot via @BotFather and get the bot token
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_URL=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_CHAT_ID=
GENERIC_WEBHOOK_URL=
